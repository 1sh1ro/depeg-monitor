# Copy to .env and fill in. Never commit .env.
# 复制为 .env 再填写。不要把 .env 提交进仓库。

# Required for live alerts. Both must be set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional extra channels.
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# Optional. Prepended to the public RPC list in config.yaml.
# RPC_ETHEREUM_URL=https://your.ethereum.rpc
# RPC_ARBITRUM_URL=https://your.arbitrum.rpc
# RPC_BSC_URL=https://your.bsc.rpc

# Optional CoinGecko demo key. The monitor runs without it.
COINGECKO_API_KEY=

LOG_LEVEL=INFO
CONFIG_PATH=config.yaml
STATE_PATH=.state/monitor_state.json
